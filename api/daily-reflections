
module.exports = async function handler(req, res) {
    const crypto = require('node:crypto');

    function validDate(value) {
        if (
            typeof value !== 'string' ||
            !/^\d{4}-\d{2}-\d{2}$/.test(value)
        ) {
            return false;
        }

        const date = new Date(value + 'T00:00:00.000Z');

        return (
            !Number.isNaN(date.getTime()) &&
            date.toISOString().slice(0, 10) === value
        );
    }

    function sendError(status, message) {
        return res.status(status).json({
            error: message
        });
    }

    try {
        if (!['GET', 'POST'].includes(req.method)) {
            res.setHeader('Allow', 'GET, POST');
            return sendError(405, 'Method not allowed');
        }

        const cookieHeader = req.headers.cookie || '';

        const sessionCookie = cookieHeader
            .split(';')
            .map(item => item.trim())
            .find(item =>
                item.startsWith('mirror_me_session=')
            );

        if (!sessionCookie) {
            return sendError(401, 'Not authenticated');
        }

        const session = sessionCookie.substring(
            'mirror_me_session='.length
        );

        const parts = session.split('.');

        if (parts.length !== 2) {
            return sendError(401, 'Invalid session');
        }

        const payloadString = parts[0];
        const receivedSignature = parts[1];

        if (!process.env.M_SESSION_SECRET) {
            console.error('M_SESSION_SECRET is missing');
            return sendError(500, 'Server configuration error');
        }

        const expectedSignature = crypto
            .createHmac(
                'sha256',
                process.env.M_SESSION_SECRET
            )
            .update(payloadString)
            .digest('base64url');

        const receivedBuffer = Buffer.from(receivedSignature);
        const expectedBuffer = Buffer.from(expectedSignature);

        if (
            receivedBuffer.length !== expectedBuffer.length ||
            !crypto.timingSafeEqual(
                receivedBuffer,
                expectedBuffer
            )
        ) {
            return sendError(401, 'Invalid session');
        }

        let payload;

        try {
            payload = JSON.parse(
                Buffer.from(
                    payloadString,
                    'base64url'
                ).toString('utf8')
            );
        } catch (error) {
            return sendError(401, 'Invalid session data');
        }

        if (
            !payload.email ||
            !payload.exp ||
            !Number.isFinite(Number(payload.exp)) ||
            Date.now() > Number(payload.exp)
        ) {
            return sendError(401, 'Session expired or invalid');
        }

        const email = String(payload.email)
            .trim()
            .toLowerCase();

        if (!email) {
            return sendError(401, 'Invalid session email');
        }

        const supabaseUrl =
            process.env.SUPABASE_URL;

        const serviceRoleKey =
            process.env.SUPABASESERVICEROLEKEY;

        if (!supabaseUrl || !serviceRoleKey) {
            console.error('Supabase environment variables are missing');
            return sendError(500, 'Server configuration error');
        }

        const supabaseHeaders = {
            apikey: serviceRoleKey,
            Authorization: 'Bearer ' + serviceRoleKey
        };

        // Resolve the signed-in member using their session email.

        const memberUrl =
            supabaseUrl.replace(/\/$/, '') +
            '/rest/v1/members?select=id&email=eq.' +
            encodeURIComponent(email) +
            '&limit=1';

        const memberResponse = await fetch(memberUrl, {
            method: 'GET',
            headers: supabaseHeaders
        });

        const memberText = await memberResponse.text();

        if (!memberResponse.ok) {
            console.error('Member lookup failed:', memberText);
            return sendError(500, 'Unable to identify member');
        }

        const members = JSON.parse(memberText);

        if (!Array.isArray(members) || members.length === 0) {
            return sendError(404, 'Member record not found');
        }

        const memberId = members[0].id;

        // SAVE TODAY'S REFLECTION

        if (req.method === 'POST') {
            let body;

            try {
                body = typeof req.body === 'string'
                    ? JSON.parse(req.body)
                    : req.body || {};
            } catch (error) {
                return sendError(400, 'Invalid request data');
            }

            const fields = [
                'well_being',
                'sleep_quality',
                'active_days',
                'physical_energy',
                'diet_quality',
                'food_confidence'
            ];

            if (!validDate(body.log_date)) {
                return sendError(400, 'Invalid reflection date');
            }

            const reflection = {
                member_id: memberId,
                log_date: body.log_date
            };

            for (const field of fields) {
                const value = body[field];

                if (
                    !Number.isInteger(value) ||
                    value < 1 ||
                    value > 5
                ) {
                    return sendError(
                        400,
                        'All six ratings must be whole numbers from 1 to 5'
                    );
                }

                reflection[field] = value;
            }

            const saveUrl =
                supabaseUrl.replace(/\/$/, '') +
                '/rest/v1/daily_logs?on_conflict=member_id,log_date';

            const saveResponse = await fetch(saveUrl, {
                method: 'POST',
                headers: {
                    ...supabaseHeaders,
                    'Content-Type': 'application/json',
                    Prefer: 'resolution=merge-duplicates,return=representation'
                },
                body: JSON.stringify(reflection)
            });

            const saveText = await saveResponse.text();

            if (!saveResponse.ok) {
                console.error('Reflection save failed:', saveText);
                return sendError(500, 'Unable to save reflection');
            }

            return res.status(200).json({
                success: true,
                reflection: JSON.parse(saveText)[0]
            });
        }

        // RETRIEVE TODAY AND THE PREVIOUS TWO DAYS

        const today = req.query?.today;

        if (!validDate(today)) {
            return sendError(
                400,
                'A valid today date is required'
            );
        }

        const fromDate = new Date(
            today + 'T00:00:00.000Z'
        );

        fromDate.setUTCDate(fromDate.getUTCDate() - 2);

        const startDate = fromDate
            .toISOString()
            .slice(0, 10);

        const historyUrl =
            supabaseUrl.replace(/\/$/, '') +
            '/rest/v1/daily_logs?select=id,log_date,well_being,sleep_quality,active_days,physical_energy,diet_quality,food_confidence,locked,confirmed_at,created_at' +
            '&member_id=eq.' + encodeURIComponent(memberId) +
            '&log_date=gte.' + startDate +
            '&log_date=lte.' + today +
            '&order=log_date.desc';

        const historyResponse = await fetch(historyUrl, {
            method: 'GET',
            headers: supabaseHeaders
        });

        const historyText = await historyResponse.text();

        if (!historyResponse.ok) {
            console.error('Reflection history failed:', historyText);
            return sendError(500, 'Unable to retrieve reflections');
        }

        return res.status(200).json({
            success: true,
            reflections: JSON.parse(historyText)
        });

    } catch (error) {
        console.error('Daily reflections API error:', error);

        return res.status(500).json({
            error: 'Server error'
        });
    }
};
